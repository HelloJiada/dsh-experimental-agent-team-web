{
  "name": "@deepseek-ai/dsh-experimental-agent-team-web",
  "description": "External Agent Teams web bundle for DeepSeek Harness",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloJiada/dsh-experimental-agent-team-web.git"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1",
    "@deepseek-ai/dsh-experimental-agent-team": "^0.1.1",
    "@deepseek-ai/dsh-invariants": "^0.1.1",
    "@deepseek-ai/dsh-session": "^0.1.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^0.1.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1",
    "@deepseek-ai/dsh-experimental-agent-team": "^0.1.1",
    "@deepseek-ai/dsh-invariants": "^0.1.1",
    "@deepseek-ai/dsh-session": "^0.1.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.16.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}
